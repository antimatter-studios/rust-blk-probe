/target/

# macOS
.DS_Store

# chore fingerprint cache (sources:/generates: checksums). Derived data.
.chore/

# chore build output
/dist/

# tier logs and the run's private copy of rust-fs-core's output-budget.sh.
# rust-fs-core's tier.sh writes tmp/logs/<tier>.log here and CI uploads the
# directory as an artifact; nothing in it is committed.
/tmp/

# The fuzz crate builds into its own target/, and libFuzzer drops a
# reproducer for anything it finds into artifacts/. A reproducer belongs in
# fuzz/corpus/ -- where tests/fuzz_decoders.rs replays it on every pull
# request -- not left where the next run would overwrite it.
/fuzz/target/
/fuzz/artifacts/
